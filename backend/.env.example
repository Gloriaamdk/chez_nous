# Copier ce fichier vers backend/.env (ce fichier-ci ne contient aucun secret) :
#   copy .env.example .env
#
# Générer une clé neuve, depuis backend/, avec l'environnement virtuel activé :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Coller le résultat entre les guillemets. Ne pas réutiliser l'ancienne clé
# qui était écrite dans config/settings.py : elle a été publiée, elle est compromise.

SECRET_KEY=""

# En local : True (même comportement qu'avant sur le PC).
# En production : False. Si la variable est absente, Django utilise False.
DEBUG=True

# Hôtes acceptés en développement. Pas d'espace après les virgules.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origines du navigateur autorisées à envoyer le jeton CSRF.
# Vite est en général sur le port 5173. Pas d'espace après les virgules.
# Depuis un téléphone sur le même réseau, ajoutez son adresse, par exemple :
#   http://192.168.1.12:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
